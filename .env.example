PORT=6969
# Optional: Last.fm play/listener counts on artist pages (free key: https://www.last.fm/api/account/create).
# Without it, song plays fall back to YouTube view counts.
LASTFM_API_KEY=
# Last.fm "Shared secret" (same page as the key) — needed for "Continue with Last.fm",
# connecting Last.fm to an account, liking songs and scrobbling.
LASTFM_API_SECRET=

# Fracital Accounts (sign-in, settings sync, Last.fm library). Accounts are disabled without DATABASE_URL.
# Tables are created automatically on first start. Remote hosts connect over SSL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/fracital
# Long random string used to sign sessions, e.g. `openssl rand -hex 32`. Don't change it once users exist.
BETTER_AUTH_SECRET=
# The auth host: the public URL OAuth providers call back to and email links point at, e.g. https://fracit.al.
BETTER_AUTH_URL=
# Optional extra allowed origins for sign-in requests (comma-separated).
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional: Better Auth dashboard API key (its app's base URL is BETTER_AUTH_URL). Off when unset.
# Grants full account and database access, so treat it like DATABASE_URL.
BETTER_AUTH_API_KEY=
# Optional OAuth sign-in. Each provider shows up once both its ID and secret are set.
# Redirect URI to register with each provider: <BETTER_AUTH_URL>/api/auth/callback/<google|discord|github|microsoft>
# OAuth providers call back to the BETTER_AUTH_URL host (the auth host, e.g. https://fracit.al). On every
# other host this server answers for, OAuth runs on the auth host in a popup and hands the session back
# (src/server/cross-site.ts), so register only the auth host's redirect URIs. Last.fm works on every host
# directly: its callback returns to the site the user started on. Changing BETTER_AUTH_URL also moves the
# default PASSKEY_RP_ID, which strands existing passkeys; set PASSKEY_RP_ID to keep them.
# Cross-site sign-in hub: one of this server's hosts that keeps a browser signed in across all of them
# (third-party cookie; see src/server/cross-site.ts). Defaults to the BETTER_AUTH_URL origin.
# Sites that may receive a sign-in: decoys in CLOAKS_DIR, CLOAK_DIRECT_HOSTS, BETTER_AUTH_TRUSTED_ORIGINS.
SIGNIN_HUB_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional, experimental: "1" lets users show what they're listening to as their Discord status
# (src/server/discord-presence.ts). Needs the Discord credentials above, and Discord must grant the
# app the activities.write scope; otherwise connecting fails at Discord. Off when unset.
DISCORD_PRESENCE=
# Optional: the bot token of the same Discord app (Developer Portal → Bot → Reset Token). Shows users
# what they're doing on Discord on their account page (src/server/discord-bot.ts). On the Bot page, turn
# on the Presence and Server Members intents, and invite the bot to the server(s). Off when unset.
DISCORD_BOT_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: "common" (default), "consumers", "organizations", or a tenant ID.
MICROSOFT_TENANT_ID=
# Passkeys are bound to one domain (and its subdomains). Defaults to the BETTER_AUTH_URL hostname.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=
# Optional: sign in with Terbium Accounts (a better-auth server, e.g. https://auth.terbiumon.top).
# Credentials are checked server-side; disabled when unset.
TERBIUM_AUTH_URL=
# SMTP for account verification emails (verification links point at BETTER_AUTH_URL). No mail is sent without SMTP_HOST.
SMTP_HOST=mail2.caan.edu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@caan.edu
SMTP_PASS=
MAIL_FROM=noreply@caan.edu
# Optional: TheAudioDB key for artist page photos (defaults to the free public key).
THEAUDIODB_API_KEY=
# Decoy sites live one-folder-per-domain here (sibling checkout by default).
# CLOAKS_DIR=/path/to/cloaks-fracital
# Hosts that should always serve the real app, never a decoy:
# CLOAK_DIRECT_HOSTS=fracital.dev,www.fracital.dev
# Gate key for the relay endpoint: the relay lives at /pipe/<key>/ instead of a
# well-known path, and the app shell is served with the path injected.
# Generate per host, e.g. `openssl rand -hex 16`. Without it the relay stays on
# the legacy path (fine for local dev, never for a public host).
WISP_GATE_KEY=
